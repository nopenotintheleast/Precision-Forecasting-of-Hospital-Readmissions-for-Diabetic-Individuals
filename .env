DATABASE_URL=postgresql://username:password@localhost:5432/diabetic_readmission #add your username and password of the postgresql and create a database diabetic_readmission
SECRET_KEY=your_secret_key_here #generate a secret key using HS256 algorithm(any site can do that)10 digit password you will get
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MODEL_PATH=ml_model/readmission_model.pkl
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com #the steps do get your email and password will be in the dev doc
MAIL_PASSWORD=your_app_password
